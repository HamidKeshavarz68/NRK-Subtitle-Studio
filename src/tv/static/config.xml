<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://github.com/HamidKeshavarz68/NRK-Subtitle-Studio" version="{{VERSION}}" viewmodes="maximized">
    <tizen:application id="NrkSubStud.NRKSubtitleStudio" package="NrkSubStud" required_version="3.0"/>
    <tizen:profile name="tv-samsung"/>
    <name>NRK Subtitle Studio</name>
    <description>Watch NRK TV with a scrolling, translated subtitle panel.</description>
    <author href="https://github.com/HamidKeshavarz68/NRK-Subtitle-Studio">NRK Subtitle Studio</author>
    <icon src="icon.png"/>
    <content src="index.html"/>
    <access origin="*" subdomains="true"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                   encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
