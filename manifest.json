{
  "manifest_version": 3,
  "name": "NRK Subtitle Studio",
  "version": "0.5.2",
  "description": "Learn Norwegian while watching NRK TV: click-to-seek subtitles, live translation, bilingual captions, and .srt export.",
  "icons": {
    "16": "public/icons/icon-16.png",
    "32": "public/icons/icon-32.png",
    "48": "public/icons/icon-48.png",
    "128": "public/icons/icon-128.png"
  },
  "background": {
    "service_worker": "dist/background/index.js"
  },
  "content_scripts": [
    {
      "matches": ["https://tv.nrk.no/*"],
      "js": ["dist/content/index.js"],
      "css": ["src/styles/overlay.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "host_permissions": [
    "https://tv.nrk.no/*",
    "https://psapi.nrk.no/*",
    "https://*.nrk.no/*",
    "https://translate.googleapis.com/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["public/icons/icon-128.png"],
      "matches": ["https://tv.nrk.no/*"]
    }
  ]
}
